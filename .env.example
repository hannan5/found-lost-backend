# Copy to .env and fill in the blanks. Never commit .env or .env.local.
#
# Two env files are loaded, in this order of precedence:
#   .env        this file's values, written by hand
#   .env.local  DATABASE_URL and AWS_* written by `neon link` / `neon deploy`
#
# First-time setup:
#   npx neon@latest login
#   npx neon@latest link --project-id cold-dawn-28701403 --branch production -y
#   npx neon@latest deploy                # applies neon.ts (the private "files" bucket)
#   npm run db:deploy && npm run db:seed

NODE_ENV=development
PORT=4000
# Public base URL of this API. Image URLs are built from it (APP_URL/api/files/...).
APP_URL=http://localhost:4000

# ----- Neon (normally in .env.local, listed here for completeness) -----
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
# Bucket name declared in neon.ts.
STORAGE_BUCKET=files
# Separate database used by the e2e tests (never the production branch: the tests wipe it).
DATABASE_URL_TEST=

# ----- Auth -----
# At least 16 characters.
JWT_SECRET=
# Access token lifetime in seconds (default 7 days).
JWT_EXPIRES_IN_SECONDS=604800

CORS_ORIGIN=http://localhost:3000

# ----- Email (optional in dev; leave SMTP_HOST empty to log mail instead of sending) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LostNFind <no-reply@lostnfind.local>"
# Receives the "new claim" notification.
ADMIN_EMAIL=admin@lostnfind.local

# ----- Seed (prisma/seed.ts) -----
SEED_ADMIN_EMAIL=admin@lostnfind.local
SEED_ADMIN_PASSWORD=
